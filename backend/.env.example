DATABASE_URL=postgresql://postgres:password@localhost:5432/esg_momentum
# For SQLite fallback during local dev:
# DATABASE_URL=sqlite:///./esg_momentum.db

OPENAI_API_KEY=sk-your-key-here
USE_MOCK_LLM=true

SECRET_KEY=changeme-super-secret-key-for-jwt
ALGORITHM=HS256

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# SMTP email delivery (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email_username
SMTP_PASSWORD=your_email_password_or_app_password
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@tricard.local
SMTP_FROM_NAME=Tricard Alerts
SMTP_TIMEOUT_SECONDS=15
