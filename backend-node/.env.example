DATABASE_URL="file:./esg_momentum.db"
PORT=8000
NODE_ENV=development

# JWT / Session
SECRET_KEY=change-me-to-a-long-random-secret
SESSION_DAYS=30

# OpenAI
OPENAI_API_KEY=sk-placeholder
OPENAI_MODEL=gpt-4.1-mini
USE_MOCK_LLM=true

# Google OAuth
GOOGLE_CLIENT_ID=

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SMTP Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@tricard.local
SMTP_FROM_NAME=Tricard Alerts

# Upload directory
UPLOAD_DIR=uploads

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173
